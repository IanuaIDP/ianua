{
  "db_name": "PostgreSQL",
  "query": "-- Every group of a tenant, oldest first, each with the roles it carries.\nSELECT g.id, g.name, g.origin, g.parent_id,\n       ARRAY(\n           SELECT gr.role_id\n           FROM group_roles gr\n           WHERE gr.tenant_id = g.tenant_id AND gr.group_id = g.id\n           ORDER BY gr.position\n       ) AS \"role_ids!\",\n       g.created_at, g.updated_at\nFROM groups g\nWHERE g.tenant_id = $1\nORDER BY g.created_at, g.id\n",
