{
  "db_name": "PostgreSQL",
  "query": "-- The approval requests of one agent of a tenant, newest first, in one\n-- status when one is given, without the people behind their delegations.\n-- A request still pending past its time to decide counts as expired, as the\n-- request itself reads, though no sweep saved it so.\nSELECT id, agent_id, delegation_id, requested_by_kind, requested_by_id, requested_by_person,\n       run_id, pending_tool, pending_arguments, pending_at_step, run_exposure, chain_depth,\n       owner_kind, owner_id, owner_person, action_class, action, status, first_by_kind,\n       first_by_id, first_by_person, first_at, decided_by_kind, decided_by_id,\n       decided_by_person, decided_at, created_at, expires_at, updated_at\nFROM agent_approvals\nWHERE tenant_id = $1 AND agent_id = $2\n  AND ($3::text IS NULL\n       OR CASE WHEN status = 'pending' AND expires_at <= $4 THEN 'expired' ELSE status END = $3)\nORDER BY created_at DESC, id DESC\n",
