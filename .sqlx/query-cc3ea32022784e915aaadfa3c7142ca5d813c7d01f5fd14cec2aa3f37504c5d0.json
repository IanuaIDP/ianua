{
  "db_name": "PostgreSQL",
  "query": "-- The runs still running that started before the cut-off, of any tenant\n-- of this database, the oldest first.\nSELECT tenant_id, id, created_at\nFROM agent_runs\nWHERE status = 'running' AND created_at < $1\nORDER BY created_at, id\nLIMIT $2\n",
