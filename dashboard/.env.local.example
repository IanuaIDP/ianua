NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=wss://api.ianua.io/api/v1
API_URL=https://api.ianua.io/api/v1

# Optional. Analytics for the public pages (landing, blog, Help Center, legal).
# Each one loads only after the visitor accepts the cookie banner. Leave a
# value empty to turn that provider off; with all three empty there is no banner.
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
MICROSOFT_CLARITY_ID=
