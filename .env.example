# Every setting is listed, with its default, in the configuration reference:
# docs/src/content/docs/reference/configuration.mdx

APP_ENV=development
LOG_LEVEL=info,ianua_server=debug

# ── Database ─────────────────────────────────────────────
# Three roles: the app's (owns nothing), the owner (migrates and makes the
# other two), and the audit purge's. All three must differ.
DATABASE_URL=postgres://ianua_app:ianua_app@localhost:5432/ianua
MIGRATION_DATABASE_URL=postgres://ianua:ianua@localhost:5432/ianua
AUDIT_PURGE_DATABASE_URL=postgres://ianua_audit_purge:ianua_audit_purge@localhost:5432/ianua
DATABASE_MAX_CONNECTIONS=10

# ── Bus and cache ────────────────────────────────────────
# Unset, both live inside the process, which only MODE=all may use. Set one,
# set both.
# BUS_URL=nats://localhost:4222
# CACHE_URL=redis://localhost:6379

# ── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
MODE=all
APP_BASE_URL=http://localhost:3001
PROXY_BASE_DOMAIN=zero.localhost

# Proxies or load balancers in front of this server, as addresses or CIDR
# blocks. X-Forwarded-For is believed ONLY from these; otherwise the client
# is the raw TCP peer. Leave empty for local development.
# TRUSTED_PROXIES=203.0.113.10

# ── Keys ─────────────────────────────────────────────────
# Each exactly 32 bytes, as 64 hex characters: openssl rand -hex 32.
# EVENT_SIGNING_SECRET must differ from HMAC_SECRET; the proxy never gets it.
HMAC_SECRET=
EVENT_SIGNING_SECRET=
ENCRYPTION_KEY=

# ── Email ────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@localhost.test
EMAIL_FROM_NAME=Ianua
SMTP_HOST=localhost
SMTP_PORT=1025
# none is allowed in development only.
SMTP_TLS=none

# For Mailgun instead:
# EMAIL_PROVIDER=mailgun
# MAILGUN_API_KEY=key-xxxxx
# MAILGUN_DOMAIN=mg.yourdomain.com

# With no mail server at all (drop the SMTP_* lines): no mail goes out, and a
# new device sets up an authenticator app instead of confirming by email.
# EMAIL_PROVIDER=none

# ── WebAuthn ─────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# ── Geolocation (optional) ──────────────────────────────
# GEOIP_DB_PATH=/path/to/GeoLite2-City.mmdb
CORS_ORIGIN=http://localhost:3001
