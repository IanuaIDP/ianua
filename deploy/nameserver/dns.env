# Nameserver configuration. Installed to /etc/ianua/dns.env at 0640 root:ianua.
#
# One file for both hosts. Everything here is identical on ns1 and ns2, because
# both answer for the same zones and must give the same answers. The only value
# that differs is this host's own certificate, and `install.sh` appends that
# from the client name it was invoked with — so there is nothing per-host to
# keep in sync, and nothing to forget.
#
# No secrets. The private key lives on the host, written by `install.sh` from
# the PKI bundle; this file only says where.

# ── What this deployment answers with ────────────────────

# No nameserver names here. Each zone arrives from the control plane carrying
# its own — named after the registration that opened it, which is what makes an
# NS record proof of whose delegation it is — so a list configured on this side
# could only ever disagree with what the zones actually answer with.

# SOA contact, written with a dot where an address has an @.
DNS_HOSTMASTER=hostmaster.ianua.io

# Port 53 on every address, which is where resolvers look and the only place
# a delegation can point. The systemd unit grants CAP_NET_BIND_SERVICE for it.
DNS_BIND=0.0.0.0:53

# ── Where the zones come from ────────────────────────────

# Setting this is what makes the process follow the control plane rather than
# read a database. It must be the external address of the cluster's gRPC
# Service — reserved and static, because nothing up here notices when it
# changes; the zones simply stop being updated.
CONTROL_PLANE_ENDPOINT=https://grpc.ianua.io:50051

# Only when the endpoint is an address and the certificate names a host.
# Otherwise the name is taken from the endpoint, which is what should happen.
#CONTROL_PLANE_SERVER_NAME=control.ianua.io

# The authority this host verifies the control plane against. Only the CA
# certificate belongs here — ca-key.pem signs everything and belongs on
# neither end of this connection.
CONTROL_PLANE_CA_CERT=/etc/ianua/pki/ca-cert.pem

# CONTROL_PLANE_CLIENT_CERT and CONTROL_PLANE_CLIENT_KEY are appended by
# install.sh, pointing at this host's own certificate (README.md, step 1).
# The control plane checks that its own authority issued it and refuses the
# connection otherwise, so that key is what separates this host from anyone
# else who finds the endpoint.

# ── Logging ──────────────────────────────────────────────

# Leave this at info. Nothing is logged per query, but failed replies and
# timed-out connections are logged at debug — and both are things a remote
# peer can cause at will, which makes debug on this host an unauthenticated
# way to fill the disk.
RUST_LOG=info
