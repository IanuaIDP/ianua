// Opens the dialogs of each page (create forms, delete / revoke confirmations, row-menu
// dialogs) and records their size, title and the line count of every text element.
//
// 1. Run it in English: it finds the dialogs and stores them in localStorage `modal-en`
//    (keys look like `1440 /route #<button index> [> <menu item index>]`).
// 2. Switch the app to the other language and run it again: it opens only the dialogs
//    English found and stores `modal-<lang>`. Compare with the snippet in SKILL.md.
//
// It never confirms anything. It still needs a signed-in browser. Use FROM / TO to run a
// slice of `allRoutes` when a run takes too long (the tool aborts after 30 silent minutes);
// each run merges into the stored result. Strip any trailing semicolon a formatter adds.
async (page) => {
  const T = '/tenants/production';
  const allRoutes = [
    '/team',
    '/tenants',
    '/settings?tab=General',
    '/notifications',
    T + '/users',
    T + '/roles',
    T + '/groups',
    T + '/domains',
    T + '/connections',
    T + '/api-keys',
    T + '/oauth-clients',
    T + '/services',
    T + '/routes',
    T + '/streams',
    T + '/pipelines',
    T + '/agents',
    T + '/flows',
    T + '/tools',
    T + '/model-providers',
    T + '/crypto/keys',
    T + '/crypto/migration',
    T + '/policy',
    T + '/settings/general',
    T + '/settings/sign-in',
    T + '/settings/mtls',
    T + '/settings/classification',
    T + '/settings/danger-zone',
  ];
  const FROM = 0;
  const TO = allRoutes.length;
  const routes = allRoutes.slice(FROM, TO);
  // Only buttons that open a form or a confirmation are clicked. Anything else (Enable, Rotate,
  // Mark as read, Save...) can change real data, so it is never clicked. Never click the
  // confirm button inside a dialog; the script only opens and closes dialogs.
  const allow =
    /^(create|add|new|register|invite|connect|classify|define)\b|^more_horiz$|^(delete|revoke|archive|suspend|cancel|remove)\b|schema/i;
  await page.goto('http://localhost:3000/overview');
  await page.waitForTimeout(3500);
  const lang = await page.evaluate(() => document.documentElement.lang);
  const prev =
    lang === 'en'
      ? null
      : JSON.parse((await page.evaluate(() => localStorage.getItem('modal-en'))) || 'null');
  const out = {};
  const tag = () =>
    page.evaluate(() => {
      document.querySelectorAll('[data-pw]').forEach((e) => e.removeAttribute('data-pw'));
      let c = 0;
      let more = 0;
      for (const b of document.querySelectorAll('button')) {
        if (b.closest('aside,nav,header,[role="dialog"]')) continue;
        const r = b.getBoundingClientRect();
        if (!r.width || !r.height) continue;
        if ((b.textContent || '').trim() === 'more_horiz' && ++more > 2) continue;
        b.setAttribute('data-pw', '1');
        c++;
      }
      return c;
    });
  const measure = () =>
    page.evaluate(() => {
      const d = document.querySelector('[role="dialog"],[role="alertdialog"]');
      if (!d) return null;
      const rows = [];
      for (const el of d.querySelectorAll('h1,h2,h3,h4,p,span,button,a,th,td,label,li,div,code')) {
        if (
          el.children.length &&
          [...el.childNodes].every((n) => n.nodeType !== 3 || !n.textContent.trim())
        )
          continue;
        const t = (el.textContent || '').trim();
        if (!t) continue;
        const r = el.getBoundingClientRect();
        if (!r.width || !r.height) continue;
        const lh = parseFloat(getComputedStyle(el).lineHeight) || 16;
        const clip =
          el.scrollWidth > el.clientWidth + 1 && getComputedStyle(el).overflow !== 'visible';
        rows.push([Math.round(r.height / lh), clip ? 'C' : '', t.slice(0, 40)]);
      }
      const r = d.getBoundingClientRect();
      return {
        w: Math.round(r.width),
        h: Math.round(r.height),
        xo: d.scrollWidth > d.clientWidth + 1,
        title: (d.querySelector('h1,h2,h3') || {}).textContent,
        rows,
      };
    });
  for (const width of [1440, 390]) {
    await page.setViewportSize({ width, height: 900 });
    for (const r of routes) {
      await page.goto('http://localhost:3000' + r, { waitUntil: 'domcontentloaded' });
      await page.waitForLoadState('networkidle', { timeout: 8000 }).catch(() => {});
      await page.waitForTimeout(800);
      const nBtn = await tag();
      for (let i = 0; i < Math.min(nBtn, 30); i++) {
        const k = `${width} ${r} #${i}`;
        if (prev && !Object.keys(prev).some((x) => x === k || x.startsWith(k + ' >'))) continue;
        await tag();
        const btn = page.locator('[data-pw="1"]').nth(i);
        const label =
          ((await btn.textContent({ timeout: 800 }).catch(() => '')) || '') +
          ((await btn.getAttribute('aria-label', { timeout: 800 }).catch(() => '')) || '');
        if (!prev && !allow.test(label.trim())) continue;
        if ((await btn.getAttribute('role', { timeout: 800 }).catch(() => null)) === 'tab') continue;
        try {
          await btn.click({ timeout: 1500, force: true });
        } catch (e) {
          continue;
        }
        await page.waitForTimeout(700);
        if (!page.url().includes(r.split('?')[0])) {
          await page.goto('http://localhost:3000' + r, { waitUntil: 'domcontentloaded' });
          await page.waitForLoadState('networkidle', { timeout: 6000 }).catch(() => {});
          await page.waitForTimeout(1200);
          continue;
        }
        let m = await measure();
        if (m) {
          out[k] = m;
          await page.keyboard.press('Escape');
          await page.waitForTimeout(300);
          continue;
        }
        const nItems = await page.locator('[role="menuitem"]:visible').count();
        for (let j = 0; j < nItems; j++) {
          const kk = `${k} > ${j}`;
          if (prev && !prev[kk]) continue;
          const it = page.locator('[role="menuitem"]:visible').nth(j);
          const itLabel = (await it.textContent({ timeout: 800 }).catch(() => '')) || '';
          if (!prev && !/delete|revoke|suspend|archive|remove|cancel|schema|members|roles|add node/i.test(itLabel)) continue;
          await it.click({ timeout: 1500, force: true }).catch(() => {});
          await page.waitForTimeout(700);
          if (!page.url().includes(r.split('?')[0])) {
            await page.goto('http://localhost:3000' + r, { waitUntil: 'domcontentloaded' });
            await page.waitForTimeout(1500);
            break;
          }
          m = await measure();
          if (m) {
            out[kk] = m;
            await page.keyboard.press('Escape');
            await page.waitForTimeout(300);
          }
          // reopen menu for the next item
          if (j < nItems - 1) {
            await page.keyboard.press('Escape');
            await btn.click({ timeout: 1500, force: true }).catch(() => {});
            await page.waitForTimeout(350);
          }
        }
        await page.keyboard.press('Escape');
        await page.waitForTimeout(200);
      }
    }
  }
  await page.evaluate(([l, o]) => { const old = JSON.parse(localStorage.getItem('modal-' + l) || '{}'); localStorage.setItem('modal-' + l, JSON.stringify(Object.assign(old, JSON.parse(o)))); }, [lang, JSON.stringify(out)]);
  return { lang, modals: Object.keys(out).length };
}
